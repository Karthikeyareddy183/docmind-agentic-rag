# Copy to backend/.env and fill in. Never commit .env.

# --- Database (PostgreSQL with pgvector; Supabase works) -------------
# Supabase: dashboard -> Connect -> "Session pooler" string, with the scheme changed to
# postgresql+asyncpg://. Prefer a dedicated least-privilege role that owns a private schema.
DOCMIND_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
DOCMIND_DB_SSL=true
# Private schema for the app's tables (not exposed by Supabase's Data API)
DOCMIND_DB_SCHEMA=docmind
# Only if you connect through a transaction-mode pooler (Supabase port 6543):
# DOCMIND_DB_TRANSACTION_POOLER=true

# Integration tests run in the separate "docmind_test" schema of this database
DOCMIND_TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres

# --- Auth ------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DOCMIND_JWT_SECRET=
DOCMIND_ACCESS_TOKEN_TTL_MINUTES=60

# --- LLM providers (standard names, read by LiteLLM) ------------------
# Set at least one and point the model settings below at it.
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=          # free tier: https://console.groq.com/keys
DOCMIND_LLM_MODEL=gemini/gemini-3.5-flash
DOCMIND_LLM_FAST_MODEL=gemini/gemini-3.5-flash-lite
DOCMIND_VISION_MODEL=gemini/gemini-3.5-flash

# --- Retrieval (defaults tuned in eval/; see docs/architecture-v2.md §11)
# Hosted (fast, best in the bake-off). Offline alternative: local:BAAI/bge-m3 (re-index after switching)
DOCMIND_EMBEDDING_MODEL=litellm:gemini/gemini-embedding-001
DOCMIND_RETRIEVAL_MODE=hybrid
DOCMIND_KEYWORD_WEIGHT=0.25
# Cross-encoder reranking: worthwhile on GPU, slow on CPU
DOCMIND_RERANK_ENABLED=false

# --- Optional: tracing (Langfuse) -------------------------------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Local caches (Hugging Face model downloads) ----------------------
# HF_HOME=D:/docmind-env/hf-cache

# --- App -------------------------------------------------------------
DOCMIND_ENVIRONMENT=development
DOCMIND_STORAGE_DIR=./data/uploads
DOCMIND_MAX_UPLOAD_MB=50
DOCMIND_RUN_WORKER_IN_API=true
DOCMIND_CORS_ORIGINS=["http://localhost:3000"]
DOCMIND_LOG_LEVEL=INFO
